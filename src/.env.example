# Copy this file to src/.env before running the application.
# Do not commit real API keys.

# LLM providers used by CV parsing and match scoring.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=

# Location services.
GOONG_API_KEY=
GOOGLE_MAPS_API_KEY=

# Elasticsearch / service endpoints.
ES_HOST=http://localhost:9200
ES_INDEX=topcv_jobs_production
FLASK_DEBUG=0
BM25_MIN_SHOULD_MATCH=2
BM25_RELAXED_MIN_SHOULD_MATCH=1
BM25_QUERY_TERM_LIMIT=30
RELAXED_RETRIEVAL_MIN_RESULTS=12
RETRIEVAL_SIZE=100
OLLAMA_URL=http://localhost:11434/api/generate

# Retrieval/scoring switches.
# Hybrid kNN is enabled automatically when indexed jobs have embeddings.
ENABLE_ESCO_EXPANSION=1
ENABLE_SKILL_GRAPH_EXPANSION=0
ENABLE_CITY_PRIORITY=1
LOCATION_SCORE_MODE=city
RETRIEVAL_FALLBACK_MIN_SCORE=1.0
RETRIEVAL_FALLBACK_MAX_SCORE=5.0

# LLM runtime tuning.
# Keep 70B for quality; reduce SCORING_TOP_N or switch to a lighter model if
# free-tier token-per-minute limits are hit during demos.
GROQ_PARSE_MODEL=llama-3.3-70b-versatile
GROQ_PARSE_MAX_COMPLETION_TOKENS=2000
GROQ_SCORING_MODEL=openai/gpt-oss-120b
GROQ_SCORING_MAX_COMPLETION_TOKENS=1500
GROQ_REASONING_EFFORT=low
GROQ_DETAIL_MODEL=llama-3.3-70b-versatile
GROQ_DETAIL_MAX_COMPLETION_TOKENS=2500
SCORING_TOP_N=50
SCORING_BATCH_SIZE=5
SCORING_BATCH_WORKERS=7
SCORING_TIME_LIMIT_SECONDS=60
SCORING_KEY_REQUEST_INTERVAL_SECONDS=5
USD_TO_VND_RATE=25000
LOCATION_DISTANCE_DECAY_KM=30
LOCATION_SCORE_FLOOR=1.5
SCORING_REQUEST_TIMEOUT_SECONDS=20
