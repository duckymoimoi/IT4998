# Copy this file to src/.env before running the application.
# Do not commit real API keys.

# LLM providers used by CV parsing and match scoring.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
COHERE_API_KEY=
COHERE_API_KEY_1=
COHERE_API_KEY_2=
COHERE_API_KEY_3=
COHERE_API_KEY_4=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://capi.aerolink.lat
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
AEROLINK_API_KEY=
AEROLINK_API_KEY_1=
AEROLINK_BASE_URL=https://capi.aerolink.lat

# Location services.
GOONG_API_KEY=
GOOGLE_MAPS_API_KEY=

# Elasticsearch / service endpoints.
ES_HOST=http://localhost:9200
ES_INDEX=topcv_jobs_production
ENABLE_SKILL_GRAPH=1
BM25_MIN_SHOULD_MATCH=20%
BM25_RELAXED_MIN_SHOULD_MATCH=10%
RELAXED_RETRIEVAL_MIN_RESULTS=12
RETRIEVAL_SIZE=80
OLLAMA_URL=http://localhost:11434/api/generate

# Retrieval/scoring switches.
# Production default favors recall: graph expansion is on, and hybrid kNN is
# enabled automatically when indexed jobs have embeddings.
ENABLE_CITY_PRIORITY=1
LOCATION_SCORE_MODE=city
RETRIEVAL_FALLBACK_MIN_SCORE=3.0
RETRIEVAL_FALLBACK_MAX_SCORE=8.0
RETRIEVAL_ONLY_MAX_RANKING_SCORE=5.5

# LLM runtime tuning.
# Keep 70B for quality; reduce SCORING_TOP_N or switch to a lighter model if
# free-tier token-per-minute limits are hit during demos.
GROQ_PARSE_MODEL=llama-3.3-70b-versatile
GROQ_PARSE_MAX_COMPLETION_TOKENS=2000
CV_PARSE_PROVIDER=auto
COHERE_PARSE_MODEL=command-r-08-2024
COHERE_PARSE_MAX_TOKENS=1800
SCORING_PROVIDER=groq
GROQ_SCORING_MODEL=openai/gpt-oss-120b
GROQ_SCORING_MAX_COMPLETION_TOKENS=3000
GROQ_DETAIL_MODEL=llama-3.3-70b-versatile
GROQ_DETAIL_MAX_COMPLETION_TOKENS=5000
COHERE_SCORING_MODEL=command-r-08-2024
COHERE_SCORING_MAX_TOKENS=2500
AEROLINK_SCORING_MODEL=claude-sonnet-4-6
AEROLINK_SCORING_MAX_TOKENS=3000
DETAIL_SCORING_PROVIDER=groq
AEROLINK_DETAIL_MODEL=claude-opus-4.8
AEROLINK_DETAIL_MAX_TOKENS=5000
SCORING_TOP_N=30
SCORING_BATCH_SIZE=5
SCORING_BATCH_WORKERS=0
SCORING_TIME_LIMIT_SECONDS=30
SCORING_REQUEST_TIMEOUT_SECONDS=30
